model User {
  id              String      @id @default(uuid())
  name            String
  email           String      @unique
  password        String?
  role            Role        @default(USER)
  status          UserStatus  @default(ACTIVE)
  googleId        String?     @unique
  isVerified      Boolean     @default(false)
  phone           String?
  avatar          String?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  donorProfile        DonorProfile?
  ownedOrganizations  Organization[]       @relation("OrgOwner")
  organizationMembers OrganizationMember[]
  requestsMade        BloodRequest[]       @relation("RequesterRelation")
  donorResponses      DonorResponse[]
  donations           Donation[]
  campRegistrations   CampRegistration[]
  notifications       Notification[]
  payments            Payment[]
  auditLogs           AuditLog[]           @relation("ActorRelation")
  reviewsGiven        Review[]             @relation("ReviewerRelation")
  reviewsReceived     Review[]             @relation("ReviewedDonorRelation")

  @@index([role, status])
  @@map("users")
}