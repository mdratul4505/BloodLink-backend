model BloodRequest {
  id             String        @id @default(uuid())
  requesterId    String
  organizationId String?

  patientName    String?
  bloodGroup     BloodGroup
  units          Int
  unitsFulfilled Int           @default(0)
  hospitalName   String
  district       String
  upazila        String?
  contactPhone   String
  note           String?

  urgency        UrgencyLevel  @default(NORMAL)
  status         RequestStatus @default(OPEN)
  neededBy       DateTime

  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  requester      User          @relation("RequesterRelation", fields: [requesterId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  responses      DonorResponse[]
  donations      Donation[]
  payments       Payment[]
  notifications  Notification[]

  @@index([status, bloodGroup, district, createdAt])
  @@index([requesterId, createdAt])
  @@index([neededBy])
  @@map("blood_requests")
}

model DonorResponse {
  id        String         @id @default(uuid())
  requestId String
  donorId   String
  status    ResponseStatus @default(AVAILABLE)
  message   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  request   BloodRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donor     User           @relation(fields: [donorId], references: [id], onDelete: Restrict)

  @@unique([requestId, donorId])
  @@index([donorId, createdAt])
  @@map("donor_responses")
}