NODE_ENV=development
PORT=5000

# Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bloodlink?schema=public"

# JWT configuration
JWT_ACCESS_SECRET=bloodlink_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=bloodlink_refresh_secret_super_secure_key_67890
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=10

# URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Super Admin Seed Credentials
ADMIN_NAME="BloodLink Super Admin"
ADMIN_EMAIL=admin@bloodlink.org
ADMIN_PASSWORD=Admin@123456

# Redis Configuration (Optional / Fallback to in-memory cache if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# bKash Sandbox Credentials (Tokenized Checkout API v1.2.0-beta)
BKASH_APP_KEY=sandbox_app_key_placeholder
BKASH_APP_SECRET=sandbox_app_secret_placeholder
BKASH_USERNAME=sandbox_username_placeholder
BKASH_PASSWORD=sandbox_password_placeholder
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/bkash/callback