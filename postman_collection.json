          "name": "POST Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "}",
                  "if (res.data && res.data.refreshToken) {",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "}",
                  "if (res.data && res.data.user && res.data.user.email) {",
                  "  pm.collectionVariables.set('userEmail', res.data.user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\",\n  \"phone\": \"01711223344\",\n  \"isDonor\": true,\n  \"bloodGroup\": \"O_POSITIVE\",\n  \"district\": \"Dhaka\",\n  \"upazila\": \"Dhanmondi\"\n}"
